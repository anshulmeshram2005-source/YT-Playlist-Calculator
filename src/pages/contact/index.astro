---
// /contact/ — Contact page
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Contact — YT Playlist Cal"
  description="Contact YT Playlist Cal — report a bug, suggest a feature, or ask a question about the YouTube playlist length calculator."
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">Contact</li>
        </ol>
      </nav>

      <h1 class="text-3xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;">Contact</h1>
      <p class="text-base mb-8" style="color: var(--color-text-muted);">Have a bug report, feature idea, or question? We'd love to hear from you.</p>

      <div
        class="rounded-xl border p-6"
        style="background-color: var(--color-surface); border-color: var(--color-border);"
      >
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="contact-type" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">Type</label>
            <select
              id="contact-type"
              name="type"
              class="w-full px-3 py-2 text-sm rounded-lg"
              style="background-color: var(--color-surface-2); border: 1.5px solid var(--color-border); color: var(--color-text); outline: none;"
            >
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="question">Question</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">Email (optional)</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="you@example.com"
              class="w-full px-3 py-2 text-sm rounded-lg"
              style="background-color: var(--color-surface-2); border: 1.5px solid var(--color-border); color: var(--color-text); outline: none;"
            />
          </div>
          <div>
            <label for="contact-message" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder="Describe the bug, feature, or your question…"
              required
              class="w-full px-3 py-2 text-sm rounded-lg resize-none"
              style="background-color: var(--color-surface-2); border: 1.5px solid var(--color-border); color: var(--color-text); outline: none;"
            ></textarea>
          </div>
          <button
            type="submit"
            id="contact-submit"
            class="w-full py-2.5 px-5 rounded-lg text-sm font-semibold transition-all duration-150"
            style="background-color: var(--color-text); color: var(--color-bg);"
          >
            Send Message
          </button>
          <div
            id="form-status"
            class="hidden text-sm text-center py-2 rounded-lg"
            role="alert"
          ></div>
        </form>
      </div>

      <div class="mt-8 text-sm" style="color: var(--color-text-muted);">
        <p>Before contacting us, please check the <a href="/faq/" style="color: var(--color-text);">FAQ</a> — your question may already be answered there.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('contact-submit') as HTMLButtonElement;
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

    // Simple client-side submission placeholder
    // In production, replace with a form endpoint (web3forms, formspree, etc.)
    await new Promise((r) => setTimeout(r, 800));

    if (statusEl) {
      statusEl.textContent = 'Message received! We\'ll get back to you if you provided an email. Thank you.';
      statusEl.style.backgroundColor = 'var(--color-success-soft)';
      statusEl.style.color = 'var(--color-success)';
      statusEl.classList.remove('hidden');
    }
    form.reset();
    if (btn) { btn.disabled = false; btn.textContent = 'Send Message'; }
  });

  ['contact-email', 'contact-message'].forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('focus', function (this: HTMLElement) {
      this.style.borderColor = 'var(--color-text)';
      this.style.boxShadow = '0 0 0 3px color-mix(in srgb, var(--color-text) 10%, transparent)';
    });
    el.addEventListener('blur', function (this: HTMLElement) {
      this.style.borderColor = 'var(--color-border)';
      this.style.boxShadow = '';
    });
  });
</script>
