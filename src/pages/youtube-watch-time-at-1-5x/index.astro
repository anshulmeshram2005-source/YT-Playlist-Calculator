---
// /youtube-watch-time-at-1-5x/ — SEO landing page targeting "youtube watch time at 1.5x"
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="YouTube Watch Time at 1.5x Speed Calculator | YT Playlist Cal"
  description="Calculate how long your YouTube playlist will take to watch at 1.5x speed. See exact time savings vs 1× speed. Free, instant, no signup required."
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">

      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/tools/" style="color: var(--color-text-muted); text-decoration: none;">Tools</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">Watch Time at 1.5×</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;">
        YouTube Watch Time at 1.5× Speed
      </h1>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
        Calculate exactly how long your YouTube playlist or video will take at 1.5× playback speed — and how much time you'll save compared to watching at normal speed.
      </p>

      <!-- CTA to main calculator -->
      <div
        class="rounded-xl border p-5 mb-10"
        style="background-color: var(--color-surface); border-color: var(--color-border);"
      >
        <p class="text-sm font-medium mb-3" style="color: var(--color-text);">Use the full calculator on the homepage:</p>
        <a
          href="/?speed=1.5"
          class="inline-flex items-center gap-2 py-2.5 px-5 rounded-lg text-sm font-semibold transition-all duration-150"
          style="background-color: var(--color-text); color: var(--color-bg);"
        >
          <span aria-hidden="true">▶</span>
          Open 1.5× Speed Calculator
        </a>
        <p class="text-xs mt-2" style="color: var(--color-text-subtle);">Paste your playlist URL → the speed is pre-set to 1.5×</p>
      </div>

      <div class="space-y-8 text-sm leading-relaxed" style="color: var(--color-text-muted);">

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">How Much Time Does 1.5× Speed Save?</h2>
          <p>
            At 1.5× playback speed, you watch content 50% faster. This means for every 3 hours of original content, you only need 2 hours to finish it.
          </p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm" style="border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden;">
              <thead>
                <tr style="background-color: var(--color-surface-2);">
                  <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Original Duration</th>
                  <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">At 1.5×</th>
                  <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Time Saved</th>
                </tr>
              </thead>
              <tbody>
                {[
                  ['30 minutes', '20 minutes', '10 minutes'],
                  ['1 hour', '40 minutes', '20 minutes'],
                  ['2 hours', '1h 20m', '40 minutes'],
                  ['5 hours', '3h 20m', '1h 40m'],
                  ['10 hours', '6h 40m', '3h 20m'],
                  ['20 hours', '13h 20m', '6h 40m'],
                  ['40 hours', '26h 40m', '13h 20m'],
                ].map(([orig, at, saved], i) => (
                  <tr style={`border-top: 1px solid var(--color-border); ${i % 2 === 1 ? 'background-color: var(--color-surface-2);' : ''}`}>
                    <td class="px-4 py-2.5 font-mono" style="color: var(--color-text);">{orig}</td>
                    <td class="px-4 py-2.5 font-semibold font-mono" style="color: var(--color-text);">{at}</td>
                    <td class="px-4 py-2.5 font-mono" style="color: var(--color-success);">-{saved}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-xs" style="color: var(--color-text-subtle);">Formula: adjusted_time = original_time ÷ 1.5</p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Who Should Watch at 1.5×?</h2>
          <p>1.5× speed is one of the most popular YouTube speeds among:</p>
          <ul class="mt-2 space-y-1 ml-4 list-disc">
            <li><strong style="color: var(--color-text);">Students</strong> — get through lecture recordings faster without losing comprehension.</li>
            <li><strong style="color: var(--color-text);">Online course learners</strong> — save hours on programming, design, or business courses.</li>
            <li><strong style="color: var(--color-text);">Podcast listeners</strong> — many podcasts work perfectly at 1.5× since speech is slower than normal reading speed.</li>
            <li><strong style="color: var(--color-text);">Review viewers</strong> — re-watch familiar content faster when reviewing before an exam.</li>
          </ul>
          <p class="mt-3">
            Research on accelerated speech suggests most people can comprehend audio at up to 1.5× before comprehension begins to drop. It is generally considered the optimal balance of speed and understanding.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Related Tools</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {[
              { href: '/', label: 'Playlist Length Calculator', desc: 'Full calculator with all speeds' },
              { href: '/youtube-watch-time-at-2x/', label: 'Watch Time at 2×', desc: 'Calculate at double speed' },
              { href: '/youtube-watch-time-calculator/', label: 'Watch Time Calculator', desc: 'Any speed, any playlist' },
              { href: '/youtube-playlist-remaining-time/', label: 'Remaining Time', desc: 'How much is left?' },
            ].map(({ href, label, desc }) => (
              <a
                href={href}
                class="block rounded-lg border p-3 transition-colors duration-150"
                style="background-color: var(--color-surface); border-color: var(--color-border); text-decoration: none;"
              >
                <p class="text-xs font-semibold" style="color: var(--color-text);">{label}</p>
                <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">{desc}</p>
              </a>
            ))}
          </div>
        </section>

      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
