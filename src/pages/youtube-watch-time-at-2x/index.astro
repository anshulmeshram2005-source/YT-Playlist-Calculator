---
// /youtube-watch-time-at-2x/ — SEO landing page for "youtube watch time at 2x"
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="YouTube Watch Time at 2x Speed Calculator | YT Playlist Cal"
  description="Calculate how long any YouTube playlist takes at 2x speed. See exactly how much time you save. Free, instant, no signup required."
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/tools/" style="color: var(--color-text-muted); text-decoration: none;">Tools</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">Watch Time at 2×</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;">
        YouTube Watch Time at 2× Speed
      </h1>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
        At 2× speed, every hour becomes 30 minutes. Calculate exactly how much time you'll save on any YouTube playlist or video.
      </p>

      <div
        class="rounded-xl border p-5 mb-10"
        style="background-color: var(--color-surface); border-color: var(--color-border);"
      >
        <p class="text-sm font-medium mb-3" style="color: var(--color-text);">Calculate your playlist at 2× speed:</p>
        <a
          href="/?speed=2"
          class="inline-flex items-center gap-2 py-2.5 px-5 rounded-lg text-sm font-semibold transition-all duration-150"
          style="background-color: var(--color-text); color: var(--color-bg);"
        >
          <span aria-hidden="true">▶</span>
          Open 2× Speed Calculator
        </a>
      </div>

      <div class="space-y-8 text-sm leading-relaxed" style="color: var(--color-text-muted);">
        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">2× Speed: Time Savings Reference</h2>
          <p>At 2× speed, you save exactly <strong style="color: var(--color-text);">50%</strong> of the original duration — the most dramatic time saving available on YouTube natively.</p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm" style="border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden;">
              <thead>
                <tr style="background-color: var(--color-surface-2);">
                  <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Original</th>
                  <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">At 2×</th>
                  <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Saved</th>
                </tr>
              </thead>
              <tbody>
                {[
                  ['30 minutes', '15 minutes', '15 minutes'],
                  ['1 hour', '30 minutes', '30 minutes'],
                  ['5 hours', '2h 30m', '2h 30m'],
                  ['10 hours', '5 hours', '5 hours'],
                  ['20 hours', '10 hours', '10 hours'],
                  ['40 hours', '20 hours', '20 hours'],
                  ['100 hours', '50 hours', '50 hours'],
                ].map(([orig, at, saved], i) => (
                  <tr style={`border-top: 1px solid var(--color-border); ${i % 2 === 1 ? 'background-color: var(--color-surface-2);' : ''}`}>
                    <td class="px-4 py-2.5 font-mono" style="color: var(--color-text);">{orig}</td>
                    <td class="px-4 py-2.5 font-semibold font-mono" style="color: var(--color-text);">{at}</td>
                    <td class="px-4 py-2.5 font-mono" style="color: var(--color-success);">-{saved}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Should You Watch at 2×?</h2>
          <p>
            2× speed requires a higher cognitive load. It works best for:
          </p>
          <ul class="mt-2 space-y-1 ml-4 list-disc">
            <li>Content you're familiar with (review sessions, second watches)</li>
            <li>Slow-paced presenters</li>
            <li>Tutorial content with long pauses or filler</li>
            <li>Reading-heavy content (code walkthroughs, slide presentations)</li>
          </ul>
          <p class="mt-3">
            For new material requiring deep comprehension, 1.25× or 1.5× is generally more effective.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Related Tools</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {[
              { href: '/', label: 'Full Playlist Calculator', desc: 'All modes and speeds' },
              { href: '/youtube-watch-time-at-1-5x/', label: 'Watch Time at 1.5×', desc: 'More moderate speed' },
              { href: '/youtube-watch-time-calculator/', label: 'Watch Time Calculator', desc: 'Any custom speed' },
              { href: '/youtube-playlist-remaining-time/', label: 'Remaining Time', desc: 'How much is left?' },
            ].map(({ href, label, desc }) => (
              <a
                href={href}
                class="block rounded-lg border p-3 transition-colors duration-150"
                style="background-color: var(--color-surface); border-color: var(--color-border); text-decoration: none;"
              >
                <p class="text-xs font-semibold" style="color: var(--color-text);">{label}</p>
                <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">{desc}</p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
