---
// index.astro — Homepage: YouTube Playlist Length Calculator
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon, { type IconName } from '../components/Icon.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://ytplaylistcal.com';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "YouTube Playlist Length Calculator",
    "url": siteUrl,
    "description": "Calculate total YouTube playlist duration, watch time at different playback speeds, remaining time, and create a daily watch schedule.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": [
      "Playlist duration calculation",
      "Playback speed adjustment",
      "Video range selection",
      "Remaining time calculation",
      "Daily watch planner",
      "Finish-by date calculator",
      "Per-video breakdown",
      "Export results"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate YouTube playlist length?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Paste your YouTube playlist URL into the calculator above and click Calculate. The tool will fetch every video in the playlist via the YouTube API and sum their durations to give you the total length in hours, minutes, and seconds."
        }
      },
      {
        "@type": "Question",
        "name": "How long is my YouTube playlist?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your playlist length depends on how many videos it contains and how long each video is. Paste your playlist URL above to get the exact total duration instantly."
        }
      },
      {
        "@type": "Question",
        "name": "Can I calculate watch time at 1.5x or 2x speed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. After calculating your playlist, the Speed Comparison table shows watch time at 0.5x, 0.75x, 1x, 1.25x, 1.5x, 1.75x, 2x, and up to 3x. You can also enter a custom speed."
        }
      },
      {
        "@type": "Question",
        "name": "Does this tool require a Google or YouTube account?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. YT Playlist Cal is completely free and requires no signup, login, or Google account. Just paste a URL and calculate."
        }
      },
      {
        "@type": "Question",
        "name": "Why are some videos missing from my count?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Some videos may be unavailable because they are private, deleted, region-restricted, or have been removed by YouTube. These are counted and clearly labeled in the results, but their duration cannot be calculated."
        }
      }
    ]
  }
];

const faqItems = [
  {
    q: 'How do I calculate YouTube playlist length?',
    a: 'Paste your YouTube playlist URL into the calculator above and click Calculate. The tool uses the YouTube Data API to fetch every video in the playlist and sum their durations to give you the exact total length in hours, minutes, and seconds.',
  },
  {
    q: 'Can I calculate watch time at 1.5x or 2x speed?',
    a: 'Yes. After calculating your playlist, the Speed Comparison table shows the adjusted watch time at 0.5x, 0.75x, 1x, 1.25x, 1.5x, 1.75x, 2x, 2.25x, 2.5x, and 3x. You can also enter a completely custom speed like 1.3x or 2.7x.',
  },
  {
    q: 'Can I calculate only part of a playlist?',
    a: 'Yes. Use the "Range" mode to specify a start and end video number. For example, set Start: 10, End: 50 to calculate only videos 10 through 50. Use "Remaining" mode to calculate how much is left after a specific video.',
  },
  {
    q: 'Why are some videos missing from my results?',
    a: 'Some videos may be unavailable due to being private, deleted, region-restricted, or removed by the uploader. These are counted and labeled in the results, but their duration cannot be fetched via the YouTube API.',
  },
  {
    q: 'How accurate is the calculation?',
    a: 'The calculation is precise — it uses the exact duration metadata from the YouTube Data API for each individual video. However, private, deleted, or unavailable videos are excluded. Live streams report 0 seconds until they end.',
  },
  {
    q: 'Does this tool store my playlist URL?',
    a: 'No. Your URL is used only to make a temporary request to the YouTube API. It is not stored, logged, or used for any other purpose. See our Privacy Policy for full details.',
  },
  {
    q: 'Do I need a YouTube API key?',
    a: 'No — the tool works without you needing to provide one. We handle API access on our server. Power users who have their own YouTube API key can optionally use it to bypass shared quota limits.',
  },
  {
    q: 'Can I calculate a single YouTube video?',
    a: 'Yes. Paste any YouTube video URL (youtube.com/watch?v=... or youtu.be/...) and it will return the video duration along with speed-adjusted watch times.',
  },
  {
    q: 'Is this tool free?',
    a: 'Yes. YT Playlist Cal is completely free, with no paid plans, no signup, and no usage limits for normal use.',
  },
  {
    q: 'Is this tool affiliated with YouTube or Google?',
    a: 'No. YT Playlist Cal is an independent utility and is not affiliated with, endorsed by, or associated with YouTube or Google LLC.',
  },
];

const features: { icon: IconName; title: string; desc: string }[] = [
  {
    icon: 'clock',
    title: 'Total Duration',
    desc: 'Get the exact total length of any public YouTube playlist in hours, minutes, and seconds.',
  },
  {
    icon: 'zap',
    title: 'Playback Speed Table',
    desc: 'See watch time and time saved at 0.5x through 3x speed. Enter any custom speed.',
  },
  {
    icon: 'crosshair',
    title: 'Video Range',
    desc: 'Calculate duration for a specific range of videos — perfect for partial course review.',
  },
  {
    icon: 'play',
    title: 'Remaining Time',
    desc: 'Tell it which video you left off at and instantly get how much time remains.',
  },
  {
    icon: 'calendar-days',
    title: 'Watch Planner',
    desc: 'Enter your daily watch budget and get an exact finish date. Plan courses, binge sessions, or study schedules.',
  },
  {
    icon: 'flag',
    title: 'Finish-By Calculator',
    desc: 'Have a deadline? Enter a target date and see the required daily viewing time and speed.',
  },
  {
    icon: 'clipboard-list',
    title: 'Per-Video Breakdown',
    desc: 'Expandable list showing every video, its duration at your chosen speed, and a direct link.',
  },
  {
    icon: 'share',
    title: 'Export & Share',
    desc: 'Export results as CSV or TXT. Copy a shareable link to send your calculation to someone else.',
  },
];

const personas: { icon: IconName; label: string }[] = [
  { icon: 'graduation-cap', label: 'Students' },
  { icon: 'laptop', label: 'Online learners' },
  { icon: 'book-open', label: 'Course buyers' },
  { icon: 'code', label: 'Developers' },
  { icon: 'award', label: 'Cert candidates' },
  { icon: 'user-round', label: 'Teachers' },
  { icon: 'clapperboard', label: 'Creators' },
  { icon: 'gamepad', label: 'Binge watchers' },
];
---

<BaseLayout
  title="YouTube Playlist Length Calculator — YT Playlist Cal"
  description="Calculate total YouTube playlist duration instantly. Get watch time at 1.5x, 2x speed, video range, remaining time, and a daily watch planner. Free, no signup required."
  jsonLd={jsonLd}
>
  <Header />

  <main id="main-content">

    <!-- ================================================
         HERO + CALCULATOR
    ================================================ -->
    <section
      class="relative pt-10 pb-16 sm:pt-14 sm:pb-20"
      aria-label="YouTube playlist length calculator"
    >
      <!-- Subtle background pattern -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="
          background-image: radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-accent) 4%, transparent), transparent 60%),
                            radial-gradient(circle at 80% 80%, color-mix(in srgb, var(--color-accent) 3%, transparent), transparent 60%);
        "
        aria-hidden="true"
      ></div>

      <div class="container relative">

        <!-- Eyebrow -->
        <div class="calculator-width text-center mb-6">
          <span
            class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest px-3 py-1.5 rounded-full"
            style="color: var(--color-accent); background-color: var(--color-accent-soft); letter-spacing: 0.08em;"
          >
            <span
              class="w-1.5 h-1.5 rounded-full animate-pulse"
              style="background-color: var(--color-accent);"
              aria-hidden="true"
            ></span>
            Free · No Signup Required · Privacy-Conscious
          </span>
        </div>

        <!-- H1 -->
        <div class="calculator-width text-center mb-3">
          <h1
            class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-tight"
            style="color: var(--color-text); letter-spacing: -0.03em;"
          >
            YouTube Playlist<br class="sm:hidden" />
            <span style="color: var(--color-accent);"> Length</span> Calculator
          </h1>
          <p
            class="mt-3 text-sm sm:text-base leading-relaxed max-w-md mx-auto"
            style="color: var(--color-text-muted);"
          >
            Calculate total playlist duration, watch time at different speeds, remaining time, and a daily watch plan.
          </p>
        </div>

        <!-- ============================================
             THE CALCULATOR — Core UI
        ============================================ -->
        <div class="calculator-width mt-8">
          <div
            id="calculator-card"
            class="rounded-xl border p-5 sm:p-6"
            style="
              background-color: var(--color-surface);
              border-color: var(--color-border);
              box-shadow: 0 1px 3px rgb(0 0 0 / 0.08), 0 4px 16px rgb(0 0 0 / 0.04);
            "
          >
            <!-- URL Input -->
            <div class="mb-4">
              <label
                for="playlist-url"
                class="block text-sm font-medium mb-2"
                style="color: var(--color-text);"
              >
                YouTube URL
              </label>
              <div class="relative">
                <textarea
                  id="playlist-url"
                  name="url"
                  rows="2"
                  placeholder="Paste a YouTube playlist, video, or channel URL here…"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  class="w-full rounded-lg px-3.5 py-3 text-sm resize-none transition-all duration-150 pr-20"
                  style="
                    background-color: var(--color-surface-2);
                    border: 1.5px solid var(--color-border);
                    color: var(--color-text);
                    font-family: var(--font-mono);
                    font-size: 13px;
                    outline: none;
                  "
                  aria-describedby="url-hint"
                ></textarea>
                <button
                  id="paste-btn"
                  type="button"
                  class="absolute right-2 top-2 text-xs font-medium px-2.5 py-1.5 rounded-md transition-colors duration-150"
                  style="
                    background-color: var(--color-surface-3);
                    color: var(--color-text-muted);
                    border: 1px solid var(--color-border);
                  "
                  aria-label="Paste from clipboard"
                >
                  Paste
                </button>
              </div>
              <p id="url-hint" class="mt-1.5 text-xs" style="color: var(--color-text-subtle);">
                Supports: playlist URL, video URL, youtu.be link, playlist ID, or video ID
              </p>
            </div>

            <!-- Mode Selector -->
            <div class="mb-4">
              <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-muted);">
                Calculation Mode
              </label>
              <div
                class="grid grid-cols-3 gap-1 p-1 rounded-lg"
                style="background-color: var(--color-surface-2);"
                role="radiogroup"
                aria-label="Calculation mode"
              >
                {['full', 'range', 'remaining'].map((mode) => (
                  <button
                    type="button"
                    data-mode={mode}
                    class="mode-btn text-xs font-medium py-2 px-2 rounded-md transition-all duration-150 capitalize"
                    style={mode === 'full'
                      ? 'background-color: var(--color-surface); color: var(--color-text); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);'
                      : 'color: var(--color-text-muted); background: transparent;'
                    }
                    aria-pressed={mode === 'full' ? 'true' : 'false'}
                  >
                    {mode === 'full' ? 'Full Playlist' : mode === 'range' ? 'Range' : 'Remaining'}
                  </button>
                ))}
              </div>
            </div>

            <!-- Range Inputs (shown in range mode) -->
            <div id="range-inputs" class="hidden mb-4">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="range-start" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">
                    Start video #
                  </label>
                  <input
                    type="number"
                    id="range-start"
                    min="1"
                    value="1"
                    class="w-full px-3 py-2 text-sm rounded-lg transition-all duration-150"
                    style="
                      background-color: var(--color-surface-2);
                      border: 1.5px solid var(--color-border);
                      color: var(--color-text);
                      outline: none;
                    "
                  />
                </div>
                <div>
                  <label for="range-end" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">
                    End video #
                  </label>
                  <input
                    type="number"
                    id="range-end"
                    min="1"
                    value="50"
                    class="w-full px-3 py-2 text-sm rounded-lg transition-all duration-150"
                    style="
                      background-color: var(--color-surface-2);
                      border: 1.5px solid var(--color-border);
                      color: var(--color-text);
                      outline: none;
                    "
                  />
                </div>
              </div>
            </div>

            <!-- Remaining Input -->
            <div id="remaining-input" class="hidden mb-4">
              <label for="watched-through" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">
                I've watched through video #
              </label>
              <input
                type="number"
                id="watched-through"
                min="1"
                placeholder="e.g. 12"
                class="w-full px-3 py-2 text-sm rounded-lg transition-all duration-150"
                style="
                  background-color: var(--color-surface-2);
                  border: 1.5px solid var(--color-border);
                  color: var(--color-text);
                  outline: none;
                "
              />
              <p class="mt-1 text-xs" style="color: var(--color-text-subtle);">Calculates all videos after this number.</p>
            </div>

            <!-- Speed Selector -->
            <div class="mb-5">
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">
                  Playback Speed
                </label>
                <input
                  type="number"
                  id="custom-speed"
                  min="0.1"
                  max="5"
                  step="0.25"
                  placeholder="Custom"
                  class="w-20 px-2 py-1 text-xs rounded-md transition-all duration-150 text-center"
                  style="
                    background-color: var(--color-surface-2);
                    border: 1.5px solid var(--color-border);
                    color: var(--color-text);
                    outline: none;
                  "
                  aria-label="Custom playback speed"
                />
              </div>
              <div class="flex flex-wrap gap-1.5" role="radiogroup" aria-label="Playback speed presets">
                {[1, 1.25, 1.5, 1.75, 2].map((speed) => (
                  <button
                    type="button"
                    data-speed={speed}
                    class="speed-btn text-xs font-medium px-3 py-1.5 rounded-md transition-all duration-150"
                    style={speed === 1
                      ? 'background-color: var(--color-text); color: var(--color-bg);'
                      : 'background-color: var(--color-surface-2); color: var(--color-text-muted); border: 1px solid var(--color-border);'
                    }
                    aria-pressed={speed === 1 ? 'true' : 'false'}
                  >
                    {speed}×
                  </button>
                ))}
              </div>
            </div>

            <!-- Advanced Options -->
            <details class="mb-5 group">
              <summary
                class="flex items-center gap-1.5 text-xs cursor-pointer select-none transition-colors duration-150"
                style="color: var(--color-text-subtle);"
              >
                <svg
                  class="w-3 h-3 transition-transform duration-150 group-open:rotate-90"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
                <span>Advanced options (custom API key, more speeds)</span>
              </summary>

              <div class="mt-3 space-y-3">
                <!-- More speeds -->
                <div>
                  <p class="text-xs mb-2" style="color: var(--color-text-muted);">Additional speeds</p>
                  <div class="flex flex-wrap gap-1.5">
                    {[0.5, 0.75, 2.25, 2.5, 3].map((speed) => (
                      <button
                        type="button"
                        data-speed={speed}
                        class="speed-btn text-xs font-medium px-3 py-1.5 rounded-md transition-all duration-150"
                        style="background-color: var(--color-surface-2); color: var(--color-text-muted); border: 1px solid var(--color-border);"
                        aria-pressed="false"
                      >
                        {speed}×
                      </button>
                    ))}
                  </div>
                </div>

                <!-- User API key -->
                <div>
                  <label for="user-api-key" class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">
                    Your YouTube API key
                    <span class="font-normal ml-1" style="color: var(--color-text-subtle);">(optional — not stored)</span>
                  </label>
                  <input
                    type="password"
                    id="user-api-key"
                    autocomplete="off"
                    placeholder="AIza..."
                    class="w-full px-3 py-2 text-sm rounded-lg transition-all duration-150 font-mono"
                    style="
                      background-color: var(--color-surface-2);
                      border: 1.5px solid var(--color-border);
                      color: var(--color-text);
                      outline: none;
                    "
                    aria-describedby="api-key-hint"
                  />
                  <p id="api-key-hint" class="mt-1 text-xs" style="color: var(--color-text-subtle);">
                    Use your own key if the shared quota is exhausted. It is only used for this request and never saved.
                  </p>
                </div>
              </div>
            </details>

            <!-- Calculate Button -->
            <button
              id="calculate-btn"
              type="button"
              class="w-full py-3 px-6 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center justify-center gap-2"
              style="
                background-color: var(--color-text);
                color: var(--color-bg);
                letter-spacing: -0.01em;
              "
              aria-live="polite"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"/>
              </svg>
              Calculate Playlist Length
            </button>

            <!-- Demo button -->
            <div class="mt-3 text-center">
              <button
                id="demo-btn"
                type="button"
                class="text-xs transition-colors duration-150"
                style="color: var(--color-text-subtle);"
              >
                Try a demo playlist →
              </button>
            </div>

          </div><!-- /calculator-card -->

          <!-- ==========================================
               LOADING STATE
          ========================================== -->
          <div
            id="loading-state"
            class="hidden mt-6 rounded-xl border p-5"
            style="
              background-color: var(--color-surface);
              border-color: var(--color-border);
            "
            aria-live="polite"
            aria-label="Calculating playlist..."
          >
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-4 h-4 border-2 rounded-full animate-spin shrink-0"
                style="border-color: var(--color-border-strong); border-top-color: var(--color-text);"
                aria-hidden="true"
              ></div>
              <span class="text-sm font-medium" style="color: var(--color-text);" id="loading-message">
                Analyzing playlist…
              </span>
            </div>
            <div id="progress-steps" class="space-y-2 ml-7">
              <!-- Steps injected by JS -->
            </div>
          </div>

          <!-- ==========================================
               ERROR STATE
          ========================================== -->
          <div
            id="error-state"
            class="hidden mt-6 rounded-xl border p-5"
            style="
              background-color: var(--color-error-soft);
              border-color: color-mix(in srgb, var(--color-error) 30%, transparent);
            "
            role="alert"
            aria-live="assertive"
          >
            <div class="flex items-start gap-3">
              <svg
                class="w-4 h-4 shrink-0 mt-0.5"
                style="color: var(--color-error);"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <div>
                <p id="error-message" class="text-sm font-semibold" style="color: var(--color-error);"></p>
                <p id="error-details" class="text-xs mt-1" style="color: var(--color-text-muted);"></p>
                <p id="error-suggestion" class="text-xs mt-2" style="color: var(--color-text-muted);"></p>
              </div>
            </div>
          </div>

          <!-- ==========================================
               RESULT DASHBOARD
          ========================================== -->
          <div id="result-section" class="hidden mt-6 space-y-4">

            <!-- Playlist Meta -->
            <div
              id="playlist-meta"
              class="rounded-xl border p-4 flex items-start gap-3"
              style="
                background-color: var(--color-surface);
                border-color: var(--color-border);
              "
            >
              <img
                id="playlist-thumbnail"
                src=""
                alt=""
                class="w-16 h-12 object-cover rounded-md shrink-0 hidden"
                loading="lazy"
              />
              <div class="min-w-0">
                <h2
                  id="playlist-title"
                  class="text-sm font-semibold truncate"
                  style="color: var(--color-text);"
                ></h2>
                <p
                  id="playlist-channel"
                  class="text-xs mt-0.5"
                  style="color: var(--color-text-muted);"
                ></p>
                <p
                  id="unavailable-notice"
                  class="hidden text-xs mt-1 px-2 py-0.5 rounded inline-block"
                  style="background-color: var(--color-warning-soft); color: var(--color-warning);"
                ></p>
              </div>
            </div>

            <!-- Metric Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" role="list" aria-label="Playlist statistics">
              {[
                { id: 'stat-total', label: 'Total Duration', value: '--' },
                { id: 'stat-count', label: 'Videos', value: '--' },
                { id: 'stat-average', label: 'Avg. Length', value: '--' },
                { id: 'stat-speed', label: 'At Selected Speed', value: '--' },
              ].map(({ id, label, value }) => (
                <div
                  role="listitem"
                  class="rounded-xl border p-4"
                  style="background-color: var(--color-surface); border-color: var(--color-border);"
                >
                  <p class="text-xs uppercase tracking-wider font-semibold mb-2" style="color: var(--color-text-subtle);">
                    {label}
                  </p>
                  <p
                    id={id}
                    class="text-xl sm:text-2xl font-bold tracking-tight"
                    style="color: var(--color-text); letter-spacing: -0.03em;"
                  >
                    {value}
                  </p>
                </div>
              ))}
            </div>

            <!-- More stats row -->
            <div class="grid grid-cols-2 gap-3">
              {[
                { id: 'stat-shortest', label: 'Shortest Video', value: '--' },
                { id: 'stat-longest', label: 'Longest Video', value: '--' },
              ].map(({ id, label }) => (
                <div
                  class="rounded-xl border p-4"
                  style="background-color: var(--color-surface); border-color: var(--color-border);"
                >
                  <p class="text-xs uppercase tracking-wider font-semibold mb-1" style="color: var(--color-text-subtle);">{label}</p>
                  <p id={id} class="text-sm font-medium" style="color: var(--color-text);">--</p>
                </div>
              ))}
            </div>

