---
// /about/ — About page
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="About YT Playlist Cal — Free YouTube Playlist Calculator"
  description="Learn about YT Playlist Cal — a free, fast, privacy-conscious YouTube playlist length and watch time calculator. Not affiliated with YouTube or Google."
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">

      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">About</li>
        </ol>
      </nav>

      <h1 class="text-3xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;">
        About YT Playlist Cal
      </h1>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
        YT Playlist Cal is a free, fast, and privacy-conscious tool for calculating the total duration of any public YouTube playlist.
      </p>

      <div class="space-y-8 text-sm leading-relaxed" style="color: var(--color-text-muted);">

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">What We Do</h2>
          <p>
            YouTube doesn't show you the total length of a playlist. If you're a student planning to finish a programming course, someone binge-watching a series before it leaves a platform, or a teacher reviewing content — you often need to know the total time commitment upfront.
          </p>
          <p class="mt-3">
            YT Playlist Cal solves that problem: paste any YouTube playlist URL and instantly get the total duration, along with watch-time estimates at different playback speeds (1×, 1.5×, 2×, or any custom speed), a per-video breakdown, and a daily watch planner to help you schedule your viewing.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Our Principles</h2>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span><strong style="color: var(--color-text);">Free, forever.</strong> The core calculator is and will remain free. No signup, no paywall, no mandatory account.</span>
            </li>
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span><strong style="color: var(--color-text);">Privacy-first.</strong> We don't store your playlist URLs. We don't track what you search for. Your API key (if you provide one) is never stored or logged.</span>
            </li>
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span><strong style="color: var(--color-text);">Honest and transparent.</strong> We clearly explain what data is processed, where it goes, and why. We don't make misleading claims about features or data handling.</span>
            </li>
            <li class="flex items-start gap-2">
              <span style="color: var(--color-accent);" aria-hidden="true">•</span>
              <span><strong style="color: var(--color-text);">Fast.</strong> The tool is built for performance — minimal JavaScript, server-side rendering, CDN delivery, and smart caching.</span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Disclaimer</h2>
          <p>
            YT Playlist Cal is an independent utility. YouTube™ and the YouTube logo are trademarks of Google LLC. This tool is not affiliated with, endorsed by, or in any way associated with YouTube or Google.
          </p>
          <p class="mt-3">
            Calculation results depend on data provided by the YouTube Data API v3. Videos that are private, deleted, region-restricted, or otherwise unavailable cannot be counted. The total duration excludes these videos.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-text);">Technology</h2>
          <p>
            YT Playlist Cal is built with <a href="https://astro.build" rel="noopener noreferrer" target="_blank" style="color: var(--color-text);">Astro</a>, hosted on <a href="https://pages.cloudflare.com" rel="noopener noreferrer" target="_blank" style="color: var(--color-text);">Cloudflare Pages</a>, and uses the <a href="https://developers.google.com/youtube/v3" rel="noopener noreferrer" target="_blank" style="color: var(--color-text);">YouTube Data API v3</a> for playlist and video metadata. The API key is stored server-side and is never exposed in client-side code.
          </p>
        </section>

        <div class="pt-6" style="border-top: 1px solid var(--color-border);">
          <a
            href="/contact/"
            class="text-sm font-medium"
            style="color: var(--color-text);"
          >
            Contact us →
          </a>
        </div>

      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
