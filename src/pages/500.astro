---
// 500.astro — Localized Custom 500 Server Error page
interface Props {
  error?: unknown;
}

const { error } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { extractLocaleFromPath, getLocalizedUrl } from '../i18n/routing';
import { getTranslations } from '../i18n/utils';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';

const detectedLocale = extractLocaleFromPath(Astro.url.pathname) || DEFAULT_LOCALE;
const locale: Locale = detectedLocale as Locale;
const t = getTranslations(locale);

const meta = t.seo?.error500 || t.meta?.error500 || {};
const errData = t.pages?.error500 || {};

const homeUrl = getLocalizedUrl('/', locale);
const contactUrl = getLocalizedUrl('/contact/', locale);
const toolsUrl = getLocalizedUrl('/tools/', locale);
---

<BaseLayout
  title={meta.title || 'Server Error — YT Playlist Cal'}
  description={meta.desc || 'Something went wrong on our servers. Please try again in a few moments.'}
  locale={locale}
  noindex={true}
>
  <Header locale={locale} />
  <main class="flex-1 py-24 text-center">
    <div class="container mx-auto px-4" style="max-width: 480px;">
      <div
        class="text-6xl font-bold mb-4 font-mono"
        style="color: var(--color-border); letter-spacing: -0.05em;"
        aria-hidden="true"
      >
        {errData.code || '500'}
      </div>
      <h1
        class="text-xl sm:text-2xl font-bold mb-2 tracking-tight"
        style="color: var(--color-text);"
      >
        {errData.title || 'Server Error'}
      </h1>
      <p class="text-sm mb-8 leading-relaxed" style="color: var(--color-text-muted);">
        {errData.desc || 'Something went wrong on our servers while processing this request. Please try refreshing the page or check back in a moment.'}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={homeUrl}
          class="inline-flex items-center gap-2 py-2.5 px-5 rounded-xl text-xs font-semibold shadow-sm transition-all duration-150"
          style="background-color: var(--color-accent); color: #ffffff;"
        >
          <Icon name="play" size={14} fill="currentColor" strokeWidth={0} />
          {errData.btn || 'Go to the Calculator'}
        </a>
        <a
          href={contactUrl}
          class="inline-flex items-center gap-2 py-2.5 px-5 rounded-xl text-xs font-semibold border transition-all duration-150"
          style="background-color: var(--color-surface-2); color: var(--color-text); border-color: var(--color-border);"
        >
          {errData.reportBtn || 'Report an issue'} &rarr;
        </a>
      </div>
      <div class="mt-6">
        <a
          href={toolsUrl}
          class="text-xs transition-colors duration-150 hover:underline"
          style="color: var(--color-text-muted);"
        >
          {errData.allTools || 'Browse all tools'} &rarr;
        </a>
      </div>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
