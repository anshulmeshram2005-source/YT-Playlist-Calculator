---
// /youtube-playlist-duration-calculator/ — SEO landing page
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="YouTube Playlist Duration Calculator — Total Playlist Length | YT Playlist Cal"
  description="Calculate the total duration of any YouTube playlist instantly. Get the exact hours, minutes, and seconds for any public playlist. Free, no signup, no API key needed."
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/tools/" style="color: var(--color-text-muted); text-decoration: none;">Tools</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">Duration Calculator</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;">
        YouTube Playlist Duration Calculator
      </h1>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
        Instantly calculate the total duration of any YouTube playlist. Get exact hours, minutes, and seconds in seconds — and plan your viewing with speed adjustments and a daily watch schedule.
      </p>

      <div class="rounded-xl border p-5 mb-10" style="background-color: var(--color-surface); border-color: var(--color-border);">
        <a href="/" class="inline-flex items-center gap-2 py-2.5 px-5 rounded-lg text-sm font-semibold" style="background-color: var(--color-text); color: var(--color-bg);">
          <Icon name="play" size={14} fill="currentColor" strokeWidth={0} /> Calculate Playlist Duration Now
        </a>
      </div>

      <div class="space-y-6 text-sm leading-relaxed" style="color: var(--color-text-muted);">
        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">Why Doesn't YouTube Show Playlist Duration?</h2>
          <p>
            YouTube does not display the total length of a playlist by default. You can see each video's individual duration in the playlist view, but there is no native sum. For playlists with hundreds of videos, manually adding up durations would take hours. That's why playlist duration calculators exist — to do this instantly via the YouTube Data API.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">Supported URL Types</h2>
          <ul class="space-y-1 ml-4 list-disc">
            <li><code class="font-mono text-xs" style="color: var(--color-text);">https://www.youtube.com/playlist?list=PLxxxxxx</code></li>
            <li><code class="font-mono text-xs" style="color: var(--color-text);">https://www.youtube.com/watch?v=xxxx&list=PLxxxxxx</code></li>
            <li><code class="font-mono text-xs" style="color: var(--color-text);">https://youtu.be/xxxx?list=PLxxxxxx</code></li>
            <li>Raw playlist ID: <code class="font-mono text-xs" style="color: var(--color-text);">PLxxxxxx</code></li>
          </ul>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">Beyond Just Duration</h2>
          <p>YT Playlist Cal goes beyond a simple duration sum. After calculating, you also get:</p>
          <ul class="space-y-1 ml-4 list-disc mt-2">
            <li>Watch time at 0.5×, 0.75×, 1×, 1.25×, 1.5×, 1.75×, 2×, 2.5×, 3× speed</li>
            <li>Shortest and longest video in the playlist</li>
            <li>Average video length</li>
            <li>Per-video breakdown with individual durations</li>
            <li>Daily Watch Planner and Finish-By Calculator</li>
            <li>Export to CSV or TXT</li>
            <li>Shareable result URL</li>
          </ul>
        </section>

        <div class="pt-4" style="border-top: 1px solid var(--color-border);">
          <p class="text-xs" style="color: var(--color-text-subtle);">
            Related: <a href="/youtube-watch-time-calculator/" style="color: var(--color-text-muted);">Watch Time Calculator</a> · <a href="/youtube-playlist-remaining-time/" style="color: var(--color-text-muted);">Remaining Time</a> · <a href="/how-it-works/" style="color: var(--color-text-muted);">How It Works</a>
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
