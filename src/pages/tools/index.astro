---
// /tools/ — All tools index page
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const tools = [
  {
    href: '/',
    title: 'YouTube Playlist Length Calculator',
    desc: 'Calculate the total duration of any YouTube playlist. Supports playback speed, range, remaining, and watch planning.',
    badge: 'Most Popular',
  },
  {
    href: '/youtube-playlist-duration-calculator/',
    title: 'Playlist Duration Calculator',
    desc: 'Dedicated landing page for calculating complete YouTube playlist duration with SEO-targeted content.',
  },
  {
    href: '/youtube-watch-time-calculator/',
    title: 'Watch Time Calculator',
    desc: 'Calculate total YouTube watch time at any playback speed across an entire playlist or video range.',
  },
  {
    href: '/youtube-playlist-remaining-time/',
    title: 'Remaining Playlist Time Calculator',
    desc: 'Pick up where you left off. Calculate how much watch time remains in a YouTube playlist.',
  },
  {
    href: '/youtube-watch-time-at-1-5x/',
    title: 'YouTube Watch Time at 1.5×',
    desc: 'Instantly calculate how long a YouTube playlist or video will take at 1.5x playback speed.',
  },
  {
    href: '/youtube-watch-time-at-2x/',
    title: 'YouTube Watch Time at 2×',
    desc: 'Calculate playlist and video duration at 2× speed. See exactly how much time you save.',
  },
];
---

<BaseLayout
  title="YouTube Tools — YT Playlist Cal"
  description="Free YouTube utility tools: playlist length calculator, watch time calculator, remaining time, playback speed calculator, and more. All free, no signup required."
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">

      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">Tools</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3" style="color: var(--color-text); letter-spacing: -0.03em;">
        YouTube Tools
      </h1>
      <p class="text-base mb-10" style="color: var(--color-text-muted);">
        Free, fast YouTube utility tools. No signup required.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tools.map(({ href, title, desc, badge }) => (
          <a
            href={href}
            class="block rounded-xl border p-5 transition-colors duration-150 group"
            style="background-color: var(--color-surface); border-color: var(--color-border); text-decoration: none;"
          >
            <div class="flex items-start justify-between gap-2 mb-2">
              <h2 class="text-sm font-semibold" style="color: var(--color-text);">{title}</h2>
              {badge && (
                <span
                  class="text-xs font-medium px-2 py-0.5 rounded-full shrink-0"
                  style="background-color: var(--color-accent-soft); color: var(--color-accent);"
                >
                  {badge}
                </span>
              )}
            </div>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{desc}</p>
          </a>
        ))}
      </div>

    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll('a[href]').forEach((el) => {
    (el as HTMLElement).addEventListener('mouseenter', function (this: HTMLElement) {
      this.style.backgroundColor = 'var(--color-surface-2)';
    });
    (el as HTMLElement).addEventListener('mouseleave', function (this: HTMLElement) {
      this.style.backgroundColor = 'var(--color-surface)';
    });
  });
</script>
