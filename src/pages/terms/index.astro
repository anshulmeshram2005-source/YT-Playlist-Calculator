---
// /terms/ — Terms of Service
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lastUpdated = '2026-10-31';
---

<BaseLayout
  title="Terms of Service | YT Playlist Cal"
  description="Terms of Service for YT Playlist Cal — rules, limitations, acceptable use, YouTube API policies, and liability disclaimers for our YouTube playlist length calculator."
  noindex={false}
>
  <Header />
  <main class="py-12 sm:py-16">
    <div class="container content-width">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-1.5 text-xs" style="color: var(--color-text-muted);">
          <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" style="color: var(--color-text);">Terms of Service</li>
        </ol>
      </nav>

      <h1 class="text-3xl font-bold tracking-tight mb-2" style="color: var(--color-text); letter-spacing: -0.03em;">Terms of Service</h1>
      <p class="text-sm mb-8" style="color: var(--color-text-muted);">Last updated: {lastUpdated}</p>

      <div class="prose-content space-y-6 text-sm leading-relaxed" style="color: var(--color-text-muted);">

        <div class="p-4 rounded-lg border text-sm" style="background-color: var(--color-surface); border-color: var(--color-border); color: var(--color-text);">
          <strong>Summary:</strong> By using YT Playlist Cal, you agree to these terms, our <a href="/privacy/" style="color: var(--color-text); text-decoration: underline;">Privacy Policy</a>, and our <a href="/disclaimer/" style="color: var(--color-text); text-decoration: underline;">Disclaimer</a>. This is a free, independent utility for estimating YouTube playlist durations.
        </div>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">1. Acceptance of Terms</h2>
          <p>
            By accessing or using YT Playlist Cal ("the Service", "the Website", "we", "us", or "our"), accessible at <strong>ytplaylistcal.com</strong>, you agree to be bound by these Terms of Service ("Terms") and all applicable laws and regulations. If you do not agree with any part of these Terms, you are prohibited from using or accessing this site.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">2. Description of the Service</h2>
          <p>
            YT Playlist Cal provides a free, web-based calculation suite designed to analyze public YouTube playlists and video URLs. The service calculates total playlist durations, computes watch times across multiple playback speeds, offers playlist range/remaining modes, and provides daily watch scheduling tools.
          </p>
          <p class="mt-2">
            The Service is provided free of charge for informational, educational, and personal planning purposes. We reserve the right to modify, suspend, or discontinue any aspect of the service at any time without notice.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">3. YouTube API & Third-Party Terms</h2>
          <p>
            YT Playlist Cal relies on the <strong>YouTube Data API v3</strong> to retrieve playlist metadata, video titles, and video durations. By using this service, you acknowledge and agree that:
          </p>
          <ul class="list-disc pl-5 mt-2 space-y-1.5">
            <li>You are bound by the <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer" style="color: var(--color-text); text-decoration: underline;">YouTube Terms of Service</a>.</li>
            <li>YouTube data is processed in accordance with the <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color: var(--color-text); text-decoration: underline;">Google Privacy Policy</a>.</li>
            <li>We do not control YouTube's servers, API quota allocations, rate limits, or metadata accuracy.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">4. Acceptable Use Policy</h2>
          <p>
            You agree to use YT Playlist Cal solely for lawful purposes. You agree <strong>not</strong> to:
          </p>
          <ul class="list-disc pl-5 mt-2 space-y-1.5">
            <li>Send excessive automated requests, bot queries, or high-frequency API calls that degrade, overwhelm, or disrupt our servers or infrastructure.</li>
            <li>Attempt to reverse-engineer, decompile, compromise, or bypass rate limits, server security controls, or Cloudflare protections.</li>
            <li>Use the Website to submit abusive, unlawful, infringing, or malicious input strings.</li>
            <li>Misrepresent your identity or attempt to gain unauthorized access to our hosting accounts, server environments, or internal endpoints.</li>
          </ul>
          <p class="mt-2">
            We reserve the right to temporarily or permanently block IP addresses or throttle requests that violate this Acceptable Use Policy.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">5. User-Provided API Keys (Optional)</h2>
          <p>
            Power users may optionally supply their own personal YouTube Data API v3 key in the Advanced Options section of the calculator.
          </p>
          <ul class="list-disc pl-5 mt-2 space-y-1.5">
            <li>Your API key is transmitted over secure HTTPS directly to our server and used strictly to execute your immediate playlist request.</li>
            <li>We do not store, log, track, or share your API key with any third party.</li>
            <li>You remain solely responsible for your Google Cloud Project, its security, and any API quota consumption associated with your personal credentials.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">6. Intellectual Property & Trademarks</h2>
          <p>
            <strong>YouTube™</strong>, the YouTube logo, and associated brands are registered trademarks of <strong>Google LLC</strong>. YT Playlist Cal is an independent project and is not affiliated with, endorsed by, or sponsored by Google LLC or YouTube.
          </p>
          <p class="mt-2">
            The original website source code, visual identity, brand mark ("Chrono Play"), custom design system, and written documentation on this site are the intellectual property of YT Playlist Cal and are protected by applicable copyright laws.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">7. Calculation Accuracy & "As Is" Disclaimer</h2>
          <p>
            All calculations, durations, playback speed savings, and scheduling projections are provided on an <strong>"AS IS" and "AS AVAILABLE"</strong> basis. While we strive for mathematical precision, discrepancies may occur due to:
          </p>
          <ul class="list-disc pl-5 mt-2 space-y-1.5">
            <li>Unavailable videos (private, deleted, age-restricted, or country-blocked videos report 0 seconds and are excluded).</li>
            <li>Ongoing live streams or unprocessed premieres without static duration metadata.</li>
            <li>Rounding differences in YouTube's ISO 8601 duration timestamps.</li>
            <li>Real-world playback variables (buffering, skipping, ads, or speed tolerances in browser media engines).</li>
          </ul>
          <p class="mt-2">
            For further details, please review our comprehensive <a href="/disclaimer/" style="color: var(--color-text); text-decoration: underline;">Disclaimer</a>.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">8. Limitation of Liability</h2>
          <p>
            To the maximum extent permitted by applicable law, YT Playlist Cal and its maintainers shall not be liable for any indirect, incidental, special, consequential, or punitive damages, including loss of time, missed deadlines, academic penalties, data loss, or system interruption arising out of your use or inability to use the service.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">9. Modifications to Terms</h2>
          <p>
            We may revise these Terms of Service at any time without prior notice. Any revisions will take effect immediately upon being posted on this page with an updated "Last updated" date. Your continued use of the service after modifications signifies your acceptance of the updated terms.
          </p>
        </section>

        <section>
          <h2 class="text-base font-semibold mb-2" style="color: var(--color-text);">10. Contact Information</h2>
          <p>
            If you have any questions or concerns regarding these Terms of Service, please contact us via our <a href="/contact/" style="color: var(--color-text); text-decoration: underline;">Contact page</a>.
          </p>
        </section>

      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

