---
// BaseLayout.astro — HTML shell with multilingual SEO, hreflang, RTL, fonts, theme, and design system
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALE_METADATA, type Locale, isValidLocale } from '../i18n/config';
import { getHreflangLinks, getAbsoluteLocalizedUrl, SITE_URL } from '../i18n/routing';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? SITE_URL;
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-08CV9EBBPD';

const {
  title,
  description,
  locale = DEFAULT_LOCALE,
  dir,
  canonical,
  ogImage = `${siteUrl}/og-image.png`,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const currentLocale: Locale = isValidLocale(locale) ? locale : DEFAULT_LOCALE;
const meta = LOCALE_METADATA[currentLocale] ?? LOCALE_METADATA.en;
const textDir = dir ?? meta.dir ?? 'ltr';

const canonicalUrl = canonical ?? getAbsoluteLocalizedUrl(Astro.url.pathname, currentLocale, siteUrl);
const hreflangLinks = getHreflangLinks(Astro.url.pathname, siteUrl);

const fullTitle = title.includes('YT Playlist Cal')
  ? title
  : `${title} | YT Playlist Cal`;
---

<!DOCTYPE html>
<html lang={meta.bcp47} dir={textDir} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js) -->
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', '${gaId}');
        `} />
      </>
    )}

    <!-- Fonts via Bunny Fonts (privacy-friendly, GDPR-compliant) -->
    <link
      href="https://fonts.bunny.net/css?family=inter:400,500,600,700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#09090b" />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Multilingual Hreflang Alternates (All 22 Locales + x-default) -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="YT Playlist Cal" />
    <meta property="og:locale" content={meta.ogLocale} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(
        Array.isArray(jsonLd) ? jsonLd : [jsonLd]
      )} />
    )}

    <!-- Organization Schema (on every page) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "YT Playlist Cal",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.svg`,
      "description": "Free YouTube playlist length and watch time calculator. Not affiliated with YouTube or Google."
    })} />

    <!-- WebSite Schema (on every page) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "YT Playlist Cal",
      "url": siteUrl,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/${currentLocale}/?url={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- No-flash theme script (runs before paint) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.remove('light', 'dark');
        document.documentElement.classList.add(theme);
      })();
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
