# YouTube Data API v3 key (server-side only — NEVER expose in client code)
# Get one at: https://console.cloud.google.com/ → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# Public site URL (used for canonical tags, OG metadata, and sitemap)
PUBLIC_SITE_URL=https://ytplaylistcal.com

# Google Analytics Measurement ID (optional)
PUBLIC_GA_ID=

# Plausible Analytics domain (optional, privacy-conscious alternative to GA)
PUBLIC_PLAUSIBLE_DOMAIN=

# Cloudflare KV for distributed caching (optional, for production)
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
